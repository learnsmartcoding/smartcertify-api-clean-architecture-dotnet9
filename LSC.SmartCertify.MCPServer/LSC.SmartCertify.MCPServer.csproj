<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LSC.SmartCertify.MCPServer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MCP Server SDK — HTTP/SSE transport for hosting in Azure -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.1.0-preview.11" />

    <!-- EF Core for DB access (same version as rest of solution) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse SmartCertifyContext and domain entities directly -->
    <ProjectReference Include="..\LSC.SmartCertify.Infrastructure\LSC.SmartCertify.Infrastructure.csproj" />
    <ProjectReference Include="..\LSC.SmartCertify.Domain\LSC.SmartCertify.Domain.csproj" />
    <ProjectReference Include="..\LSC.SmartCertify.Application\LSC.SmartCertify.Application.csproj" />
  </ItemGroup>

</Project>
